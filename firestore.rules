rules_version = '2';
// 娃娃機台平面圖 — Firestore 安全規則
// 只有下列 Google 帳號（且 Email 已驗證）可以讀取與寫入；其他人一律拒絕。
// 要新增帳號：在清單中加入 Email（並同步修改 index.html 的 OWNER_EMAILS）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['qew59601211@gmail.com'];
    }

    // 所有機台資料：floorplans/main
    match /floorplans/{docId} {
      allow read, write: if isOwner();
    }

    // 其他任何路徑都禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
